{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/amodmulay/architecture-design-toolkit/schemas/architecture.schema.json",
  "title": "Architecture Model",
  "description": "Technology-neutral architecture model used as the source of truth for diagram and documentation generation.",
  "type": "object",
  "required": ["name", "components", "connections"],
  "properties": {
    "model_version": { "type": "string", "default": "1.0" },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "scope": { "type": "string" },
    "assumptions": { "type": "array", "items": { "type": "string" } },
    "metadata": { "type": "object", "additionalProperties": { "type": ["string", "number", "boolean", "null"] } },
    "boundaries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]*$" },
          "title": { "type": "string", "minLength": 1 },
          "type": { "type": "string" },
          "description": { "type": "string" },
          "parent_id": { "type": "string" },
          "provider": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "responsibility"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]*$" },
          "title": { "type": "string", "minLength": 1 },
          "responsibility": { "type": "string", "minLength": 1 },
          "category": { "type": "string" },
          "provider": { "type": "string" },
          "technology": { "type": "string" },
          "icon_id": { "type": "string" },
          "boundary": { "type": "string" },
          "layer": { "type": "string" },
          "notes": { "type": "string" },
          "width": { "type": "integer", "minimum": 120, "maximum": 400 },
          "height": { "type": "integer", "minimum": 70, "maximum": 240 }
        },
        "additionalProperties": false
      }
    },
    "connections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "source", "target", "label"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]*$" },
          "source": { "type": "string" },
          "target": { "type": "string" },
          "label": { "type": "string" },
          "protocol": { "type": "string" },
          "mode": { "enum": ["sync", "async", "batch", "stream", "unknown"] },
          "style": { "type": "string" },
          "data_classification": { "type": "string" },
          "description": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "views": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "component_ids": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
